# build artifacts
dist
**/dist
apps/macos/.build
apps/ios/build
**/*.trace

# large app trees not needed for CLI build
apps/
assets/
Peekaboo/
Swabble/
Core/
Users/
vendor/

# Needed for building the Canvas A2UI bundle during Docker image builds.
# Keep the rest of apps/ and vendor/ excluded to avoid a large build context.
!apps/shared/
!apps/shared/OpenClawKit/
!apps/shared/OpenClawKit/Tools/
!apps/shared/OpenClawKit/Tools/CanvasA2UI/
!apps/shared/OpenClawKit/Tools/CanvasA2UI/**
!vendor/a2ui/
!vendor/a2ui/renderers/
!vendor/a2ui/renderers/lit/
!vendor/a2ui/renderers/lit/**

# Additional .dockerignore entries to reduce build context
# Append these to the existing .dockerignore in the OpenClaw repo

# VPS-specific files
docker-compose.override.yml
docker-compose.yml.bak
docker-compose.yml.bak-*
*.bak
*.bak-*
*.archived

# Environment and secrets (NEVER include in build context)
.env
.env.*

# Test files
test/
test-*.mjs
test-*.js
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# Documentation (not needed at runtime)
docs/*
!docs/reference/
*.md
!docs/reference/templates/*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml

# Deployment configs
fly.toml
fly.private.toml
render.yaml
docker-setup.sh
Dockerfile.original
Dockerfile.sandbox
Dockerfile.sandbox-browser

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
*~

# Git hooks (not needed in image)
git-hooks/

# Runtime templates (required by OpenClaw gateway)
!docs/reference/
!docs/reference/templates/
!docs/reference/templates/**
